@model IEnumerable<EventDetailsVm>
@{
    ViewBag.Title = "Events";
}

<div class="container py-5 events-page">
    <div class="text-center mb-4">
        <h1 class="display-6 fw-bold mb-2">@ViewBag.Title</h1>
        <p class="text-muted mb-0">What’s happening this year at The Filling Station.</p>
    </div>

    @* Featured Upcoming *@
    @foreach(var featured in Model.Where(ev => ev.Badge == "Featured"))
    {
        <div class="card-fs p-4 p-md-5 mb-4 events-featured">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="pill events-pill">Upcoming</span>
                @if (!string.IsNullOrWhiteSpace(featured.Badge))
                {
                    <span class="pill events-pill-alt">@featured.Badge</span>
                }
            </div>

            <h2 class="h3 fw-bold mb-1">@featured.Title</h2>

            <div class="text-muted mb-3">
                <strong>@featured.EventDate.ToString("dddd, MMMM d, yyyy")</strong>
                <span class="mx-2">•</span>
                @featured.StartTime
            </div>

            <p class="mb-0">@featured.Summary</p>
        </div>
    }

    @* Timeline List *@
    <div class="card-fs p-3 p-md-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="fw-semibold">All Events</div>
            <div class="text-muted small">Updated as new events are announced.</div>
        </div>

        @{
            string currentMonth = "";
        }

        <div class="events-list">
            @foreach (var e in Model.OrderByDescending(x => x.EventDate).ThenBy(x => x.StartTime))
            {
                var monthLabel = e.EventDate.ToString("MMMM yyyy");
                if (monthLabel != currentMonth)
                {
                    currentMonth = monthLabel;
                    <div class="events-month">@currentMonth</div>
                }

                <div class="events-item">
                    <div class="events-date">
                        <div class="events-day">@e.EventDate.ToString("dd")</div>
                        <div class="events-dow">@e.EventDate.ToString("ddd")</div>
                    </div>

                    <div class="events-body">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="events-title">@e.Title</div>
                            @if (!string.IsNullOrWhiteSpace(e.Badge))
                            {
                                <span class="pill events-pill-alt">@e.Badge</span>
                            }
                        </div>

                        <div class="text-muted small">
                            @e.EventDate.ToString("MMMM d, yyyy") • @e.StartTime
                        </div>

                        <div class="events-summary text-muted">
                            @e.Summary
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
